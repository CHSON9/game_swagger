          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    }
  },
  "info": {
    "description": "powered by Flasgger",
    "termsOfService": "/tos",
    "title": "A swagger API",
    "version": "0.0.1"
  },
  "paths": {
    "/auth/check-id": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "username": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부 반환"
          }
        },
        "summary": "아이디 중복 확인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/check-nickname": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "nickname": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부 반환"
          }
        },
        "summary": "닉네임 중복 확인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Login"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "로그인 성공"
          }
        },
        "summary": "로그인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Signup"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "회원가입 성공"
          }
        },
        "summary": "회원가입 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/game/end": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "role": {
                  "type": "string"
                },
                "session_id": {
                  "type": "integer"
                },
                "touch_count": {
                  "type": "integer"
                },
                "user_id": {
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "저장 완료"
          }
        },
        "summary": "최종 결과 데이터 저장",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/result/{session_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공"
          }
        },
        "summary": "결과창용 상세 데이터 조회",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/start": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "tagger_id": {
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "세션 생성 성공"
          }
        },
        "summary": "게임 세션 생성 및 시작",
        "tags": [
          "Game"
        ]
      }
    },
    "/socket_docs": {
      "get": {
        "description": "이 섹션은 소켓 이벤트를 설명합니다.\n\n1. **image_frame (Client -\u003E Server)**\n   - image_data: Base64 이미지\n   - user_id: 유저 ID\n   \n2. **result_data (Server -\u003E Client)**\n   - status: \"대기중/탐지중/성공/실패\"\n   - is_detected: true/false (감지 여부)\n   - confidence: 0~100 (신뢰도)\n   - touch_event: true/false (터치 여부)\n   - current_hits: 누적 터치 횟수\n   - time_left: 남은 시간 (초)",
        "summary": "실시간 통신(Socket.io) 명세서",
        "tags": [
          "Real-time (Socket.io)"
        ]
      }
    }
  },
  "swagger": "2.0"
}
