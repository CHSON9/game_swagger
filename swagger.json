{
  "definitions": {
    "CheckID": {
      "properties": {
        "username": {
          "description": "중복 확인할 아이디",
          "type": "string"
        }
      }
    },
    "CheckNickname": {
      "properties": {
        "nickname": {
          "description": "중복 확인 할 닉네임",
          "type": "string"
        }
      }
    },
    "GameEnd": {
      "properties": {
        "role": {
          "enum": [
            "tagger",
            "runner"
          ],
          "type": "string"
        },
        "session_id": {
          "type": "integer"
        },
        "touch_count": {
          "type": "integer"
        },
        "user_id": {
          "type": "integer"
        }
      }
    },
    "GameResultResponse": {
      "properties": {
        "data": {
          "items": {
            "id": "GameResultDetail",
            "properties": {
              "result_id": {
                "type": "integer"
              },
              "role": {
                "enum": [
                  "tagger",
                  "runner"
                ],
                "type": "string"
              },
              "session_id": {
                "type": "integer"
              },
              "touch_count": {
                "type": "integer"
              },
              "user_id": {
                "type": "integer"
              }
            }
          },
          "type": "array"
        },
        "status": {
          "example": "success",
          "type": "string"
        }
      }
    },
    "GameStartRequest": {
      "properties": {
        "tagger_id": {
          "description": "select-tagger에서 받아온 술래의 User ID",
          "example": 1,
          "type": "integer"
        }
      }
    },
    "Login": {
      "properties": {
        "password": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    },
    "Signup": {
      "properties": {
        "nickname": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      }
    }
  },
  "info": {
    "description": "powered by Flasgger",
    "termsOfService": "/tos",
    "title": "A swagger API",
    "version": "0.0.1"
  },
  "paths": {
    "/auth/check-id": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CheckID"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부 반환"
          }
        },
        "summary": "아이디 중복 확인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/check-nickname": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/CheckNickname"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "사용 가능 여부 반환"
          }
        },
        "summary": "닉네임 중복 확인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/login": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Login"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "로그인 성공"
          }
        },
        "summary": "로그인 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/auth/signup": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Signup"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "회원가입 성공"
          },
          "400": {
            "description": "회원가입 실패"
          }
        },
        "summary": "회원가입 API",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/detect_test": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "session_id": {
                  "description": "세션 ID (미입력 시 서버의 현재 세션 번호 사용)",
                  "example": 1,
                  "type": "integer"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "로그 기록 성공"
          }
        },
        "summary": "움직임 감지 로그 기록 (AI 엔진/테스트용)",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/end": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameEnd"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "저장 완료"
          }
        },
        "summary": "최종 결과 데이터 저장",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/result/{session_id}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "session_id",
            "required": true,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "조회 성공",
            "schema": {
              "$ref": "#/definitions/GameResultResponse"
            }
          }
        },
        "summary": "결과창용 상세 데이터 조회",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/select-tagger": {
      "post": {
        "responses": {
          "200": {
            "description": "술래 선정 성공",
            "schema": {
              "properties": {
                "status": {
                  "example": "success",
                  "type": "string"
                },
                "tagger_id": {
                  "example": 5,
                  "type": "integer"
                }
              }
            }
          },
          "400": {
            "description": "접속 중인 유저 없음"
          }
        },
        "summary": "접속 중인 유저 중 랜덤으로 술래 한 명을 선정",
        "tags": [
          "Game"
        ]
      }
    },
    "/game/start": {
      "post": {
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GameStartRequest"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "세션 생성 성공",
            "schema": {
              "properties": {
                "session_id": {
                  "example": 1,
                  "type": "integer"
                },
                "status": {
                  "example": "success",
                  "type": "string"
                },
                "tagger_id": {
                  "example": 1,
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "기억된 tagger_id로 실제 게임 세션을 생성하고 시작",
        "tags": [
          "Game"
        ]
      }
    },
    "/socket_docs": {
      "get": {
        "description": "이 섹션은 게임 중 발생하는 실시간 소켓 이벤트를 설명합니다.\n\n1. **image_frame (Client -\u003E Server)**\n   - image: Base64 이미지 데이터 (주의: 키값이 'image'입니다)\n   \n2. **game_update (Server -\u003E Client)**\n   - **result_image**: AI가 가공한 투명화 처리된 Base64 이미지\n   - **score**: 현재 실시간 누적 점수\n   - **tagger_id**: 현재 설정된 술래의 User ID\n   - **invisible_ids**: 현재 투명화 처리 중인 유저 ID 리스트\n   - **status**: 게임 진행 상태 (예: \"playing\")",
        "summary": "실시간 통신(Socket.io) 명세서",
        "tags": [
          "Real-time (Socket.io)"
        ]
      }
    }
  },
  "swagger": "2.0"
}
